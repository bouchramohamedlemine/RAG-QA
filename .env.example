# Copy to .env and fill in. .env is git-ignored; never commit it or paste keys into chat.

# Supabase dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase dashboard > Connect > "Session pooler" connection string, with your database password in it.
# Used to read the existing SQL functions, change the schema and load papers in bulk.
SUPABASE_DB_URL=

# platform.openai.com > a new project just for PaperQA, with a hard spend limit > API keys
OPENAI_API_KEY=

# dashboard.cohere.com > API keys
COHERE_API_KEY=
